# Local development only. In Docker/Coolify, set this runtime variable to your
# separately hosted MongoDB URI using a hostname reachable from the app container.
# Example: mongodb://USER:URL_ENCODED_PASSWORD@MONGODB_HOST:27017/pittplanner?authSource=admin
# For Atlas, use the URI from Connect > Drivers and include the database name.
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/pittplanner
# Generate your own value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret
PORT=4444
